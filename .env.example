# Algoritm Academy — muhit o'zgaruvchilari namunasi
# Ushbu faylni `.env.local` deb nusxalab, qiymatlarni to'ldiring.

# --- Telegram bildirishnomalari (arizalar saytdan tushganda) ---
# Bot yaratish: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token
# Xabarlar boradigan chat/guruh ID si (@username o'rniga raqamiy ID)
TELEGRAM_CHAT_ID=-1001234567890

# --- Admin (CRM) paroli (/admin sahifasi) ---
# O'zgartirishni UNUTMANG! Agar o'rnatilmasa default: algoritm-admin-2026
ADMIN_PASSWORD=

# --- Sayt URL (SEO metadataBase uchun) ---
# NEXT_PUBLIC_SITE_URL=https://sizning-domen.uz

# --- Arizalar saqlanadigan fayl (ixtiyoriy) ---
# Default: <proyekt>/.data/leads.json (gitignore qilingan)
# LEADS_FILE=/var/data/algoritm-leads.json
