# Algoritm Academy — muhit o'zgaruvchilari namunasi
# Ushbu faylni `.env.local` deb nusxalab, qiymatlarni to'ldiring.

# --- 🐘 PostgreSQL Markaziy Ma'lumotlar Bazasi (TAVSIYA ETILADI: Supabase yoki Neon) ---
# Serverless (Vercel) va doimiy ma'lumotlar saqlanishi uchun MAJBURIY.
# Agar o'rnatilsa — arizalar, ustozlar, guruhlar, talabalar va davomat
# to'liq umumiy PostgreSQL bazasida xavfsiz va yo'qolmasdan saqlanadi.
# Format: postgres://username:password@hostname:5432/dbname?sslmode=require
# Masalan:
# DATABASE_URL=postgres://default:pass@ep-cool-pooler.eu-central-1.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Telegram bildirishnomalari (arizalar saytdan tushganda) ---
# Bot yaratish: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Xabarlar boradigan chat/guruh ID si (@username o'rniga raqamiy ID)
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# --- Admin (CRM) paroli (/admin sahifasi) ---
# MAJBURIY (production). O'rnatilmasa prod'da admin paneli 503 qaytaradi.
# Dev'da fallback: algoritm-admin-2026
ADMIN_PASSWORD=

# Sessiya cookie'sini imzolash kaliti (tavsiya etiladi).
# Yaratish: openssl rand -hex 32
# O'rnatilmasa ADMIN_PASSWORD dan hosil qilinadi (parol o'zgarsa sessiyalar bekor bo'ladi).
ADMIN_SESSION_SECRET=

# --- Ustoz sessiyasi va Davomat tizimi ---
# Production'da MAJBURIY. Kuchli tasodifiy secret ishlating (kamida 32 bayt).
# Yaratish: openssl rand -hex 32
TEACHER_SESSION_SECRET=

# Ustozlar va davomat ma'lumotlarini saqlash:
# TEACHERS_REDIS_KEY=algoritm:teachers
# TEACHERS_FILE=/var/data/algoritm-teachers.json
# ATTENDANCE_FILE=/var/data/algoritm-attendance.json

# --- Telegram Webhook xavfsizligi ---
# Telegram Bot Webhook so'rovlarini tekshirish uchun secret token (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=           # Production'da majburiy; Telegram webhook headeri
TELEGRAM_ADMIN_IDS=                  # Bot adminlarining Telegram user ID lari, vergul bilan


# --- Rate-limit uchun haqiqiy IP manbasi (MUHIM) ---
# Sayt reverse-proxy (nginx, Cloudflare) ORQASIDA tursa — proksi o'zi yozadigan
# sarlavha nomini shu yerga yozing. Bu o'rnatilmasa proksi sarlavhalariga
# ishonilmaydi (ularni istalgan bot soxtalashtira oladi) va o'rniga umumiy
# chegara qo'llanadi — spam himoyasi kuchsizroq bo'ladi.
#   nginx:      TRUSTED_IP_HEADER=x-real-ip
#   Cloudflare: TRUSTED_IP_HEADER=cf-connecting-ip
# Vercel'da kerak emas — u avtomatik aniqlanadi (x-vercel-forwarded-for).
# TRUSTED_IP_HEADER=

# --- Sayt URL (SEO metadataBase uchun) ---
# NEXT_PUBLIC_SITE_URL=https://sizning-domen.uz

# --- Arizalar saqlash ---
# 1-variant (TAVSIYA, serverless/Vercel uchun): Upstash Redis REST
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx
# LEADS_REDIS_KEY=algoritm:leads

# 2-variant (lokal/VPS): JSON fayl
# Default: <proyekt>/.data/leads.json (gitignore qilingan)
# LEADS_FILE=/var/data/algoritm-leads.json
